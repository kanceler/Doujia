{
  "schema_version": "devflow.pipeline.registry/v0.4",
  "registry_id": "scheduling_partial_repair_sibling_registry",
  "entry_pipeline_id": "parent_partial_repair",
  "pipeline_defs": [
    {
      "schema_version": "devflow.pipeline/v0.4",
      "pipeline_id": "owner_repairable_code",
      "kind": "subpipeline",
      "name": "Owner Repairable Code",
      "namespace": {
        "agents": [{"name": "coder", "role": "coder", "default_agent_id": "coder01"}],
        "bags": [{"name": "module_input"}, {"name": "code_bag"}, {"name": "failure_report"}]
      },
      "signature": {
        "input_bags": [{"name": "module_input"}],
        "output_bags": [{"name": "code_bag"}],
        "exported_handlers": [{
          "name": "debug_code",
          "handler": "debug_code",
          "handles": ["kbug"],
          "replaces": [{"name": "code_bag"}]
        }]
      },
      "handlers": [{
        "name": "debug_code",
        "handles": ["kbug"],
        "transition": "debug_code",
        "input_bags": [
          {"name": "failure_report", "source": "exception"},
          {"name": "module_input", "source": "owner_input"},
          {"name": "code_bag", "source": "owner_output"}
        ],
        "replace_bags": [{"name": "code_bag", "from_transition": "debug_code"}],
        "resume": {"type": "retry_failed_transition"}
      }],
      "start_state": "start",
      "delivery_state": "done",
      "states": [
        {"id": "start", "kind": "start", "proof": {"type": "external"}, "next": {"type": "all", "transitions": ["debug_code"]}},
        {"id": "done", "kind": "delivery", "proof": {"type": "transition_result", "transition": "debug_code"}, "exposes": {"bags": [{"name": "code_bag"}]}}
      ],
      "transitions": [{
        "id": "debug_code",
        "kind": "task",
        "from_state": "start",
        "to_state": "done",
        "agent": {"role": "coder", "alias": "coder"},
        "op": "debug_write_code",
        "input_bags": [{"name": "module_input"}, {"name": "code_bag"}, {"name": "failure_report"}],
        "output_bags": [{"name": "code_bag"}],
        "limits": {"max_attempts": 3}
      }]
    },
    {
      "schema_version": "devflow.pipeline/v0.4",
      "pipeline_id": "test_data_ready",
      "kind": "subpipeline",
      "name": "Reusable Test Data",
      "namespace": {
        "agents": [{"name": "tester", "role": "tester", "default_agent_id": "tester01"}],
        "bags": [{"name": "module_input"}, {"name": "test_data"}]
      },
      "signature": {
        "input_bags": [{"name": "module_input"}],
        "output_bags": [{"name": "test_data"}]
      },
      "start_state": "start",
      "delivery_state": "done",
      "states": [
        {"id": "start", "kind": "start", "proof": {"type": "external"}, "next": {"type": "all", "transitions": ["write_test_data"]}},
        {"id": "done", "kind": "delivery", "proof": {"type": "transition_result", "transition": "write_test_data"}, "exposes": {"bags": [{"name": "test_data"}]}}
      ],
      "transitions": [{
        "id": "write_test_data",
        "kind": "task",
        "from_state": "start",
        "to_state": "done",
        "agent": {"role": "tester", "alias": "tester"},
        "op": "test_data",
        "input_bags": [{"name": "module_input"}],
        "output_bags": [{"name": "test_data"}]
      }]
    },
    {
      "schema_version": "devflow.pipeline/v0.4",
      "pipeline_id": "checker_uses_code_and_data",
      "kind": "subpipeline",
      "name": "Checker Uses Code And Data",
      "namespace": {
        "agents": [{"name": "tester", "role": "tester", "default_agent_id": "tester01"}],
        "bags": [{"name": "code_bag"}, {"name": "test_data"}, {"name": "failure_report"}]
      },
      "signature": {
        "input_bags": [{"name": "code_bag"}, {"name": "test_data"}],
        "throws": [{"result": "kbug", "bags": [{"name": "failure_report"}]}]
      },
      "start_state": "start",
      "delivery_state": "done",
      "states": [
        {"id": "start", "kind": "start", "proof": {"type": "external"}, "next": {"type": "all", "transitions": ["test_code"]}},
        {"id": "done", "kind": "delivery", "proof": {"type": "transition_result", "transition": "test_code"}}
      ],
      "transitions": [{
        "id": "test_code",
        "kind": "task",
        "from_state": "start",
        "to_state": "done",
        "agent": {"role": "tester", "alias": "tester"},
        "op": "test_code",
        "input_bags": [{"name": "code_bag"}, {"name": "test_data"}],
        "output_bags_by_result": {"kbug": [{"name": "failure_report"}]}
      }]
    },
    {
      "schema_version": "devflow.pipeline/v0.4",
      "pipeline_id": "parent_partial_repair",
      "kind": "entry",
      "name": "Parent Partial Repair",
      "namespace": {
        "agents": [{"name": "coder", "role": "coder", "default_agent_id": "coder01"}],
        "bags": [{"name": "module_input"}, {"name": "code_bag"}, {"name": "test_data"}, {"name": "failure_report"}]
      },
      "handlers": [{
        "name": "debug_code",
        "handles": ["kbug"],
        "transition": "debug_code",
        "input_bags": [{"name": "failure_report", "source": "exception"}],
        "replace_bags": [{"name": "code_bag"}],
        "resume": {"type": "retry_failed_transition"}
      }],
      "exception_handlers": {
        "kbug": {
          "select": "nearest_matching",
          "join": "all_success",
          "on_unhandled": "fail_run",
          "resume": {"type": "retry_failed_transition"}
        }
      },
      "start_state": "start",
      "delivery_state": "done",
      "states": [
        {"id": "start", "kind": "start", "proof": {"type": "external"}, "next": {"type": "all", "transitions": ["call_owner", "call_test_data", "call_checker"]}},
        {"id": "done", "kind": "delivery", "proof": {"type": "external"}}
      ],
      "transitions": [
        {
          "id": "call_owner",
          "kind": "call",
          "pipeline_id": "owner_repairable_code",
          "from_state": "start",
          "to_state": "done",
          "mode": "single",
          "bindings": {"input_bags": {"module_input": {"name": "module_input"}}},
          "output_bags": [{"name": "code_bag"}],
          "output_handlers": [{"name": "debug_code", "from_handler": "debug_code"}]
        },
        {
          "id": "call_test_data",
          "kind": "call",
          "pipeline_id": "test_data_ready",
          "from_state": "start",
          "to_state": "done",
          "mode": "single",
          "bindings": {"input_bags": {"module_input": {"name": "module_input"}}},
          "output_bags": [{"name": "test_data"}]
        },
        {
          "id": "call_checker",
          "kind": "call",
          "pipeline_id": "checker_uses_code_and_data",
          "from_state": "start",
          "to_state": "done",
          "mode": "single",
          "bindings": {
            "input_bags": {
              "code_bag": {"name": "code_bag"},
              "test_data": {"name": "test_data"}
            }
          }
        },
        {
          "id": "debug_code",
          "kind": "task",
          "from_state": "start",
          "to_state": "done",
          "agent": {"role": "coder", "alias": "coder"},
          "op": "debug_write_code",
          "limits": {"max_attempts": 3},
          "output_bags": [{"name": "code_bag"}]
        }
      ]
    }
  ]
}
