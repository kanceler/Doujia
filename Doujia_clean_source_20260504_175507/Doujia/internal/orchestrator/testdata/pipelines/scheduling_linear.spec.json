{
  "schema_version": "devflow.pipeline.registry/v0.4",
  "registry_id": "scheduling_linear_registry",
  "entry_pipeline_id": "scheduling_linear",
  "pipeline_defs": [
    {
      "schema_version": "devflow.pipeline/v0.4",
      "pipeline_id": "scheduling_linear",
      "kind": "entry",
      "name": "Scheduling Linear",
      "signature": {
        "output_bags": [{"name": "test_report"}]
      },
      "namespace": {
        "agents": [
          {"name": "architect", "role": "architect", "default_agent_id": "architect01"},
          {"name": "coder", "role": "coder", "default_agent_id": "coder01"},
          {"name": "tester", "role": "tester", "default_agent_id": "tester01"}
        ],
        "bags": [
          {"name": "requirements"},
          {"name": "code_bag"},
          {"name": "test_report"}
        ]
      },
      "start_state": "requirements_ready",
      "delivery_state": "tested",
      "states": [
        {
          "id": "requirements_ready",
          "kind": "start",
          "proof": {"type": "external"},
          "next": {"type": "all", "transitions": ["write_code"]}
        },
        {
          "id": "code_written",
          "kind": "state",
          "proof": {"type": "transition_result", "transition": "write_code"},
          "exposes": {"bags": [{"name": "code_bag", "from_transition": "write_code"}]},
          "next": {"type": "all", "transitions": ["test_code"]}
        },
        {
          "id": "tested",
          "kind": "delivery",
          "proof": {"type": "transition_result", "transition": "test_code"},
          "exposes": {"bags": [{"name": "test_report", "from_transition": "test_code"}]}
        }
      ],
      "transitions": [
        {
          "id": "write_code",
          "kind": "task",
          "from_state": "requirements_ready",
          "to_state": "code_written",
          "agent": {"role": "coder", "alias": "coder"},
          "op": "write_code",
          "input_bags": [{"name": "requirements", "from_state": "requirements_ready"}],
          "output_bags": [{"name": "code_bag", "required": true}]
        },
        {
          "id": "test_code",
          "kind": "task",
          "from_state": "code_written",
          "to_state": "tested",
          "agent": {"role": "tester", "alias": "tester"},
          "op": "test_code",
          "input_bags": [{"name": "code_bag", "from_state": "code_written"}],
          "output_bags": [{"name": "test_report", "required": true}]
        }
      ]
    }
  ]
}
